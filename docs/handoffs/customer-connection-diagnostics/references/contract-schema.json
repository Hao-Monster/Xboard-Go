{
  "contract_name": "xboard.customer_connection_diagnostics",
  "schema_version": 1,
  "revision": "2026-10-18-review1",
  "identity": {
    "panel_scope_format": "uuid_v4_lowercase",
    "diagnostic_id": {
      "algorithm": "sha256_prefix_hex",
      "domain_prefix": "xboard-diag:v1\\u0000",
      "separator": "\\u0000",
      "input_template": "xboard-diag:v1\\u0000{panel_scope}\\u0000{subscriber_user_id_decimal}",
      "hex_length": 24,
      "case": "lowercase"
    },
    "event_id": {
      "algorithm": "sha256_full_hex",
      "input_template": "{panel_scope}/{node_id}/{runtime_id}/{event_family}/{owner_id}/{sequence}",
      "hex_length": 64,
      "case": "lowercase"
    },
    "hex_lengths": {
      "diagnostic_id": 24,
      "runtime_id": 32,
      "connection_id": 32,
      "resolver_operation_id": 32,
      "session_id": 32,
      "trace_id": 32,
      "span_id": 16,
      "event_id": 64
    }
  },
  "budgets": {
    "max_event_bytes": 4096,
    "max_stack_bytes": 2048,
    "max_stack_frames": 12,
    "max_stack_frame_bytes": 192,
    "max_safe_message_chars": 256,
    "max_requested_host_chars": 253,
    "max_outbound_tag_chars": 128,
    "max_dns_answers": 8,
    "max_span_links": 4,
    "max_udp_targets_per_session": 64,
    "max_active_leases_per_panel": 10,
    "lease_ttl_seconds": 900,
    "lease_max_rtt_ms": 5000,
    "node_queue_max_events": 2048,
    "node_queue_max_bytes": 8388608,
    "node_queue_reserved_baseline_ratio": 0.25
  },
  "enums": {
    "event_family": [
      "connection",
