XBOARD_ADDRESS=127.0.0.1:8080
XBOARD_DATABASE_DSN=file:./data/xboard.db
XBOARD_PANEL_URL=http://127.0.0.1:5173
# Compatibility path used by the Xboard v2 administrator API. Set this to the
# existing panel's secure_path when running differential tests or migrating.
XBOARD_LEGACY_ADMIN_PATH=admin
XBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5173
XBOARD_COOKIE_SECURE=false
XBOARD_NODE_RELEASE=v1.14.3
XBOARD_SCHEDULER_INTERVAL=1s
XBOARD_WEBSOCKET_ENABLED=true
# Optional absolute ws:// or wss:// public endpoint. Empty derives it from the request host.
XBOARD_WEBSOCKET_URL=
XBOARD_NODE_PUSH_INTERVAL=60
XBOARD_NODE_PULL_INTERVAL=60
# Optional absolute path to a built frontend. The container image sets this automatically.
XBOARD_WEB_ROOT=

# Optional private attachment storage. Enabling it requires XBOARD_SETTINGS_ENCRYPTION_KEY.
XBOARD_ATTACHMENT_ROOT=
XBOARD_ATTACHMENT_CHUNK_SIZE=5242880
XBOARD_ATTACHMENT_MAX_FILE_SIZE=1073741824
XBOARD_ATTACHMENT_TOTAL_QUOTA=21474836480
XBOARD_ATTACHMENT_SIGNED_URL_TTL=2h
XBOARD_ATTACHMENT_DRAFT_TTL=24h
XBOARD_ATTACHMENT_TRASH_TTL=168h
XBOARD_ATTACHMENT_MAX_PER_ARTICLE=100

# CAPTCHA verification uses fixed Google and Cloudflare HTTPS endpoints by default.
# The following overrides are test-only. Never enable them in a shared or production environment.
XBOARD_CAPTCHA_ALLOW_INSECURE=false
XBOARD_CAPTCHA_RECAPTCHA_VERIFY_URL=
XBOARD_CAPTCHA_RECAPTCHA_V3_VERIFY_URL=
XBOARD_CAPTCHA_TURNSTILE_VERIFY_URL=

# Set both only for the first local startup. Never commit real credentials.
XBOARD_BOOTSTRAP_ADMIN_EMAIL=
XBOARD_BOOTSTRAP_ADMIN_PASSWORD=
# Prefer this file-backed variant in containers; do not set both password variables.
XBOARD_BOOTSTRAP_ADMIN_PASSWORD_FILE=
