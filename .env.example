XBOARD_ADDRESS=127.0.0.1:8080
XBOARD_DATABASE_DSN=file:./data/xboard.db
XBOARD_PANEL_URL=http://127.0.0.1:5173
XBOARD_ALLOWED_ORIGINS=http://127.0.0.1:5173
XBOARD_COOKIE_SECURE=false
XBOARD_NODE_RELEASE=v1.14.3
XBOARD_SCHEDULER_INTERVAL=1s
XBOARD_WEBSOCKET_ENABLED=true
# Optional absolute ws:// or wss:// public endpoint. Empty derives it from the request host.
XBOARD_WEBSOCKET_URL=
XBOARD_NODE_PUSH_INTERVAL=60
XBOARD_NODE_PULL_INTERVAL=60
# Optional absolute path to a built frontend. The container image sets this automatically.
XBOARD_WEB_ROOT=

# Set both only for the first local startup. Never commit real credentials.
XBOARD_BOOTSTRAP_ADMIN_EMAIL=
XBOARD_BOOTSTRAP_ADMIN_PASSWORD=
# Prefer this file-backed variant in containers; do not set both password variables.
XBOARD_BOOTSTRAP_ADMIN_PASSWORD_FILE=
